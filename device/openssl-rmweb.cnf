# Optional per-app OpenSSL config for rmweb. NOT installed by any script: see docs/tls.md.
#
# reMarkable's system policy (/etc/ssl/openssl.cnf.d/10-reduce-tls-ciphers.cnf) limits TLS 1.2 to
# ECDHE-ECDSA suites. Servers that present an RSA certificate and do not offer TLS 1.3 (Libby's API
# hosts among them) share no suite with that list, so the handshake fails.
#
# This file is the system list plus the three forward-secret AEAD suites for RSA certificates.
# Unchanged: TLS 1.2 minimum, the TLS 1.3 suites, certificate verification. Still excluded: CBC
# suites and anything without forward secrecy.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_configuration

[ssl_configuration]
system_default = system_default_tls

[system_default_tls]
MinProtocol = TLSv1.2
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:TLS_AES_128_CCM_SHA256
CipherString = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-CCM:ECDHE-ECDSA-AES128-CCM:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305
